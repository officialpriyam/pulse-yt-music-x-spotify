# Public browser origin. On Vercel, use the Next.js project's HTTPS origin.
PULSE_PUBLIC_URL=http://localhost:3000
PULSE_BIND=127.0.0.1:4000

# Runtime uses the pooled URL. Migrations run separately with the direct URL.
DATABASE_URL_POOLED=
DATABASE_URL=
DATABASE_URL_DIRECT=
# Configure Upstash REST, or use a native Redis connection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PULSE_TOKEN_KEY=

# Optional Data API v3 key for public YouTube search without Google sign-in.
YOUTUBE_API_KEY=

# Optional OAuth clients. Leave both values empty for a provider you are not enabling.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional capacity defaults. Tune after measuring your deployment.
PULSE_DB_POOL_SIZE=2
PULSE_MAX_INFLIGHT=32
PULSE_REQUESTS_PER_MINUTE=6000
PULSE_OAUTH_PER_MINUTE=180
PULSE_SESSION_PER_MINUTE=120
