# Public WEB origin. The Next.js proxy keeps auth and cookies on this origin.
PULSE_PUBLIC_URL=http://localhost:3000
PULSE_BIND=127.0.0.1:4000

# Set all four to enable Google login and database features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL_POOLED=
DATABASE_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PULSE_TOKEN_KEY=
